# Flask app settings
SECRET_KEY="change-me-in-production"
FLASK_ENV="development"
HOST="127.0.0.1"
PORT="5000"

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# For local development with SQLite (default):
DATABASE_URL="sqlite:///campus_plug.db"
# For production / Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.XXXXXX.supabase.co:5432/postgres"

# Public URL for self-referential links and payment callbacks
APP_URL="http://127.0.0.1:5000"

# Redis for rate limiting (required in production):
REDIS_URL="redis://localhost:6379/0"

# Resend API key for transactional emails (sign up at https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Paystack API keys for MoMo and card transaction processing with escrow
# Get test keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Development-only credentials used by `seed_data()` when running locally.
# For safety, set these in your local .env if you want reproducible dev passwords.
DEV_STUDENT_PASSWORD=""
DEV_ADMIN_PASSWORD=""

# IMPORTANT: Do NOT commit your local .env file. Use environment variables
# or your host's secret manager (e.g., Render) to provide real production keys.
